{
  "name": "algoverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cinematic DSA visualiser built on a pure trace-replay architecture \u2014 90+ algorithms, one playback engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "homepage": "https://github.com/algoverse/algoverse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algoverse/algoverse.git"
  },
  "bugs": {
    "url": "https://github.com/algoverse/algoverse/issues"
  },
  "keywords": [
    "algorithms",
    "data-structures",
    "visualiser",
    "visualization",
    "education",
    "react",
    "typescript",
    "vite",
    "dsa",
    "trace-replay"
  ],
  "engines": {
    "node": ">=20"
  }
}
